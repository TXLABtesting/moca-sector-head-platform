# Frontend (Vite) configuration.
# Copy to .env.local and fill in. .env.local is git-ignored — never commit secrets.

# Base path the SPA is served from (root when behind nginx same-origin).
VITE_BASE=/

# ─── Data backend the running SPA uses ───────────────────────────────────────
# The current app reads/writes through the Supabase shared backend (with a
# browser-local fallback when these are absent). Set both to activate it.
# The anon key is PUBLIC by design (protected by Row-Level Security). NEVER put
# a service-role / admin key here or anywhere in the frontend.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
VITE_DEMO_BUCKET=demo-uploads
# Must equal demo_config.reset_passphrase in the database (see supabase/schema.sql).
VITE_DEMO_RESET_PASSPHRASE=CHANGE-ME
# Show the "Demo Environment" banner.
VITE_DEMO=false

# ─── Production API (NestJS) — for when the REST seam (app/src/api) is wired ──
# API base (same-origin via nginx by default).
VITE_API_BASE=/api/v1

# ─── Microsoft Entra ID (SPA app registration) ───────────────────────────────
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Must be registered as a SPA redirect URI on the app registration.
VITE_ENTRA_REDIRECT_URI=https://platform.moca.gov.ae
# Delegated scope exposed by the API app registration.
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
