# ── Demo backend (Supabase) ─────────────────────────────────────────────────
# Copy this file to `.env.local` and fill in your DEMO Supabase project values.
# .env.local is git-ignored — credentials are NEVER committed.
#
# Both vars must be set for the shared demo database to activate. When absent,
# the app falls back to browser-local storage (single-browser demo).
#
# The anon key is PUBLIC by design (protected by Row-Level Security). NEVER put
# a service-role / admin key here or anywhere in the frontend.

VITE_SUPABASE_URL=https://YOUR-DEMO-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-DEMO-ANON-PUBLIC-KEY

# Storage bucket for demo file uploads (default: demo-uploads)
VITE_DEMO_BUCKET=demo-uploads

# Must equal demo_config.reset_passphrase in the database (see supabase/schema.sql).
# Gates the admin "Reset demo data" action.
VITE_DEMO_RESET_PASSPHRASE=CHANGE-ME

# Show the "Demo Environment" banner (default: true on the demo branch).
VITE_DEMO=true

# ── Production build ─────────────────────────────────────────────────────────
# The production branch is built WITHOUT these demo vars (or with its own
# production Supabase/backend config). Set VITE_DEMO=false there.
