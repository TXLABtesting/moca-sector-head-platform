# Frontend (Vite) configuration for the production (it) build.
# Copy to .env.local and fill from your Entra app registrations.

# Base path the SPA is served from (root when behind nginx same-origin).
VITE_BASE=/

# API base (same-origin via nginx by default).
VITE_API_BASE=/api/v1

# ─── Microsoft Entra ID (SPA app registration) ────────────────────────────
VITE_ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
VITE_ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Must be registered as a SPA redirect URI on the app registration.
VITE_ENTRA_REDIRECT_URI=https://platform.moca.gov.ae
# Delegated scope exposed by the API app registration.
VITE_ENTRA_API_SCOPE=api://00000000-0000-0000-0000-000000000000/access_as_user
