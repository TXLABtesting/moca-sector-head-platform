# ─── Server ───────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
# Comma-separated allowed origins for the SPA (CORS).
CORS_ORIGINS=http://localhost:5180,http://localhost:4173

# ─── PostgreSQL ───────────────────────────────────────────────────────────
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=moca
DB_PASSWORD=change_me_in_secret_store
DB_DATABASE=moca_sector_head
# Set true ONLY in local dev; production runs SQL migrations instead.
DB_SYNCHRONIZE=false
DB_SSL=false

# ─── Microsoft Entra ID (Azure AD) — OpenID Connect ───────────────────────
# Directory (tenant) ID of the MOCA Entra tenant.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
# Application (client) ID of the API app registration.
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000
# Client secret is only needed for the confidential auth-code exchange helper
# endpoint; store it in Azure Key Vault, never in source control.
ENTRA_CLIENT_SECRET=
# The Application ID URI / audience the API expects in incoming access tokens
# (e.g. api://<client-id>). Tokens whose aud != this are rejected.
ENTRA_API_AUDIENCE=api://00000000-0000-0000-0000-000000000000
# Accepted token version issuer. v2.0 endpoint:
#   https://login.microsoftonline.com/<tenant>/v2.0
ENTRA_ISSUER=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/v2.0
# JWKS endpoint used to validate token signatures.
ENTRA_JWKS_URI=https://login.microsoftonline.com/00000000-0000-0000-0000-000000000000/discovery/v2.0/keys
# Redirect URI registered on the SPA app registration (front-end handles the
# interactive login with MSAL; the API is resource-only).
ENTRA_REDIRECT_URI=https://platform.moca.gov.ae/auth/callback

# ─── Azure Blob Storage (attachments) ─────────────────────────────────────
BLOB_ACCOUNT=mocasectorhead
BLOB_CONTAINER=attachments
# Prefer Managed Identity in Azure; connection string only for local/dev.
BLOB_CONNECTION_STRING=

# ─── Bootstrap ────────────────────────────────────────────────────────────
# Entra object id (oid) of the first System Admin, granted the sysadmin role
# on first boot so the team can manage everyone else in-app.
BOOTSTRAP_SYSADMIN_OID=
